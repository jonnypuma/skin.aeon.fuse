<?xml version="1.0" encoding="UTF-8"?>
<!--
	Add-on browser (Aeon library layout): page header, pills replacing Estuary's side blade in the
	card header, view 50 list in the card, add-on icon / summary in the detail panel.
	Kodi ids from Estuary Omega: view 50, menucontrol 9000, radiobuttons 7 (hide foreign) /
	8 (hide incompatible), buttons 9 (check repository updates) / 5 (add-on settings),
	3 / 4 sort buttons (hidden; the SORT sub-nav item clicks 3).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>AG_Background</include>
		<include content="Aeon_AddonFanart"><param name="art" value="$INFO[Container(50).ListItem.Art(fanart)]"/><param name="cond" value="!String.IsEmpty(Container(50).ListItem.Art(fanart)) + !Container(50).ListItem.IsParentFolder"/></include>
		<!-- 0.56.53 a folder of a repository (Video add-ons, Services ...) has no fanart of its own: the repository's
		     (script.aeon.helper aeon.ab.repofanart), before the backdrop -->
		<include content="Aeon_AddonFanart"><param name="art" value="$INFO[Window(Home).Property(aeon.ab.repofanart)]"/><param name="cond" value="String.IsEmpty(Container(50).ListItem.Art(fanart)) + !String.IsEmpty(Window(Home).Property(aeon.ab.repofanart))"/></include>
		<include content="AG_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$LOCALIZE[24001]"/>
			<param name="sub" value="$INFO[Container.FolderName]"/>
		</include>
		<control type="group">
			<left>666</left>
			<top>168</top>
			<width>1134</width>
			<height>848</height>
			<include condition="!$EXP[FGS]">AG_Card</include>
		</control>
		<!-- Aeon: the add-on icon sits right next to the list with a thin frame; name / status under it -->
		<control type="group">
			<visible>$EXP[Aeon_VGlass] + !$EXP[FGS]</visible>
			<include>AG_GenericDetail</include>
		</control>
		<control type="group">
			<left>page_margin</left>
			<top>168</top>
			<width>600</width>
			<height>848</height>
			<visible>![$EXP[Aeon_VGlass]] + Integer.IsGreater(Container.NumItems,0) + !$EXP[FGS]</visible>
			<include>Anim_FadeVisible</include>
			<control type="image"><left>90</left><top>0</top><width>456</width><height>452</height><texture colordiffuse="ff565656">common/white.png</texture><visible>!$EXP[Aeon_Fused]</visible></control>
			<control type="image"><left>92</left><top>2</top><width>454</width><height>448</height><texture colordiffuse="ff000000">common/white.png</texture><visible>!$EXP[Aeon_Fused]</visible></control>
			<control type="image"><left>92</left><top>2</top><width>454</width><height>448</height><aspectratio>keep</aspectratio><fadetime>160</fadetime><texture background="true">$VAR[AG_RowIconLarge]</texture><visible>!$EXP[Aeon_Fused]</visible></control>
			<!-- Fuse: a rounded card, the picture rounded with it -->
			<control type="image"><left>90</left><top>0</top><width>456</width><height>452</height><texture border="32" colordiffuse="x_panel">aeon/card_panel.png</texture><visible>$EXP[Aeon_Fused]</visible></control>
			<control type="image"><left>92</left><top>2</top><width>452</width><height>448</height><aspectratio scalediffuse="false">keep</aspectratio><fadetime>160</fadetime><texture background="true" diffuse="aeon/mask_round18.png">$VAR[AG_RowIconLarge]</texture><visible>$EXP[Aeon_Fused]</visible></control>
			<!-- the menu entries (My add-ons, Install from repository ...) have no artwork of their own: a line icon instead of a black box -->
			<control type="image"><left>199</left><top>106</top><width>240</width><height>240</height><aspectratio>keep</aspectratio><fadetime>160</fadetime><texture colordiffuse="ddffffff">$VAR[Aeon_AddonTile]</texture></control>
			<control type="label"><left>92</left><top>480</top><width>460</width><height>130</height><font>lb_display_52</font><textcolor>$VAR[AG_Ink]</textcolor><wrapmultiline>true</wrapmultiline><label>$VAR[AG_RowLabel]</label></control>
			<control type="label"><left>92</left><top>628</top><width>460</width><height>30</height><font>lb_ui_22</font><textcolor>$VAR[AG_Ink2]</textcolor><label>$INFO[ListItem.Label2]</label></control>
		</control>
		<include condition="!$EXP[FGS]">View_50_List</include>
		<include condition="$EXP[FGS]">FGS_View50</include><!-- 0.56.30 fgs_round2 --><!-- 0.56.37 fgs_addons -->
		<control type="image">
			<left>666</left>
			<top>866</top>
			<width>1134</width>
			<height>150</height>
			<texture diffuse="aeon/mask_fade_card.png" colordiffuse="$VAR[AG_Surface]">aeon/fade_bottom_150.png</texture>
			<visible>$EXP[Aeon_VGlass] + !$EXP[Aeon_FGlass]</visible><!-- 0.56.11 not over the Fused Glass card -->
		</control>
		<!-- empty folder / still loading -->
		<control type="label">
			<left>720</left>
			<top>300</top>
			<width>1040</width>
			<height>66</height>
			<textoffsetx>0</textoffsetx>
			<font>lb_cap_20</font>
			<textcolor>$VAR[AG_Ink3]</textcolor>
			<label>$LOCALIZE[31012]</label>
			<animation effect="slide" start="0,0" end="126,-49" time="0" condition="$EXP[FGS]">Conditional</animation>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
		</control>
		<!-- last repository check, bottom-left -->
		<control type="label">
			<left>page_margin</left>
			<top>124</top>
			<width>1100</width>
			<height>30</height>
			<font>lb_small_20</font>
			<textcolor>$VAR[AG_Ink3]</textcolor>
			<label>$INFO[Window(AddonBrowser).Property(Updated),$ADDON[skin.aeon.fuse 32015]  ,]</label>
			<animation effect="slide" start="0,0" end="-60,888" time="0" condition="$EXP[FGS]">Conditional</animation>
		</control>
		<control type="grouplist" id="9000">
			<left>720</left>
			<top>200</top>
			<width>1040</width>
			<animation effect="slide" start="0,0" end="-359,-19" time="0" condition="$EXP[FGS]">Conditional</animation><include content="Param_H" condition="$EXP[FGS]"><param name="h" value="70"/></include><include content="Param_H" condition="!$EXP[FGS]"><param name="h" value="subnav_h"/></include>
			<orientation>horizontal</orientation>
			<include condition="$EXP[FGS]">FGS_Gap0</include><include condition="!$EXP[FGS]">FGS_Gap10_Else</include>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup>SetFocus(50)</onup><onup>Action(LastPage)</onup>
			<ondown>50</ondown>
			<onback>50</onback>
			<include content="AG_SubNavButton"><param name="fgs" value="true"/>
				<param name="id" value="6053"/>
				<param name="label" value="$LOCALIZE[31010]: $INFO[Container.SortMethod]"/>
				<param name="onclick" value="SendClick(3)"/>
				<param name="visible" value="Control.IsEnabled(3)"/>
			</include>
			<!-- 0.56.10 Hide foreign / Hide incompatible as the same pill as Check for updates (the user: "they should look the
			     same as that check for updates button"); Kodi toggles its setting on a click of id 7 / 8, the dot in front shows
			     it: gold when the filter is on -->
			<include content="AG_SubNavButton"><param name="fgs" value="true"/>
				<param name="id" value="7"/>
				<param name="label" value="$VAR[AB_FilterDot7]$LOCALIZE[25001]"/>
				<param name="visible" value="Control.IsEnabled(7)"/>
			</include>
			<include content="AG_SubNavButton"><param name="fgs" value="true"/>
				<param name="id" value="8"/>
				<param name="label" value="$VAR[AB_FilterDot8]$LOCALIZE[24999]"/>
				<param name="visible" value="Control.IsEnabled(8)"/>
			</include>
			<include content="AG_SubNavButton"><param name="fgs" value="true"/>
				<param name="id" value="9"/>
				<param name="label" value="$LOCALIZE[24034]"/>
			</include>
			<include content="AG_SubNavButton"><param name="fgs" value="true"/>
				<param name="id" value="5"/>
				<param name="label" value="$LOCALIZE[10004]"/>
			</include>
		</control>
		<control type="button" id="3">
			<description>Sort by (Kodi)</description>
			<include>AG_Hidden</include>
		</control>
		<control type="button" id="4">
			<description>Sort order (Kodi)</description>
			<include>AG_Hidden</include>
		</control>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Spotlight options of one home menu item (dialog 1162): Up key on/off, autoscroll, default items and hold time. Opened from Settings > Home menu. -->
<window type="dialog" id="1162">
	<defaultcontrol always="true">9810</defaultcontrol>
	<animation type="WindowOpen" tween="cubic" easing="out"><effect type="fade" start="0" end="100" time="200"/></animation>
	<animation type="WindowClose" tween="cubic" easing="in"><effect type="fade" start="100" end="0" time="200"/></animation>
	<controls>
		<include condition="$EXP[Aeon_FGlass] + $EXP[FGS]">Spot1162_FGS</include>
		<include condition="![$EXP[Aeon_FGlass] + $EXP[FGS]]">Spot1162_Classic</include>
	</controls>
</window>

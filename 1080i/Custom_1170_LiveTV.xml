<?xml version="1.0" encoding="UTF-8"?>
<!-- Live TV on Home (dialog 1170): the channel group of its second row, and how many channels a row holds.
     Opened from Settings > Home menu > Edit spotlight with Live TV selected. -->
<window type="dialog" id="1170">
	<defaultcontrol always="true">9871</defaultcontrol>
	<animation type="WindowOpen" tween="cubic" easing="out"><effect type="fade" start="0" end="100" time="200"/></animation>
	<animation type="WindowClose" tween="cubic" easing="in"><effect type="fade" start="100" end="0" time="200"/></animation>
	<controls>
		<include condition="$EXP[Aeon_FGlass] + $EXP[FGS]">Spot1170_FGS</include>
		<include condition="![$EXP[Aeon_FGlass] + $EXP[FGS]]">Spot1170_Classic</include>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogSettings (M4, Builder E). One file, two looks (picked at window load per dialog instance):
	  · osdaudiosettings / osdsubtitlesettings / osdvideosettings / osdcmssettings:
	    720px right-hand panel over the video with AUDIO / SUBTITLES / VIDEO tabs
	    (mockups/AVSettings.dc.html, SPEC Decision 10). Tabs close the current dialog and open the
	    sibling; Window(Home).Property(aeon.osdtab) marks a tab swap so the panel doesn't re-slide.
	    The panel hides while the offset slider (DialogSlider) is up so the picture stays clear.
	  · everything else (lock, content, PVR timer, profile, source settings ...): centred dialog.
	Id contract (Estuary Omega): heading 2, control area grouplist 5, templates 7-15, scrollbar 60,
	buttons 28 / 29 / 30 in grouplist 9000 (Kodi labels/hides them). Aeon ids: tabs 9101-9103.
-->
<window>
	<defaultcontrol>5</defaultcontrol>
	<onload>ClearProperty(aeon.osdtab,home)</onload>
	<include condition="!$EXP[Dlg_IsOSDSettings]">Anim_DialogOpenClose</include>
	<controls>
		<include condition="!$EXP[Dlg_IsOSDSettings] + !$EXP[Aeon_MS] + !$EXP[FGS]">Dlg_SettingsCentred</include>
		<include condition="!$EXP[Dlg_IsOSDSettings] + !$EXP[Aeon_MS] + $EXP[FGS]">FGS_SettingsCentred</include>
		<include condition="$EXP[Dlg_IsOSDSettings] + !$EXP[Aeon_MS] + !$EXP[FGS]">Dlg_SettingsPanel</include>
		<include condition="$EXP[Dlg_IsOSDSettings] + !$EXP[Aeon_MS] + $EXP[FGS]">FGS_SettingsPanel</include>
		<!-- Aeon theme menu styles (_src/ms_menus.py) -->
		<include condition="$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_mosaic]">MS_OSDSet_mosaic</include>
		<include condition="!$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_mosaic]">MS_DlgSet_mosaic</include>
		<include condition="$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_ledger]">MS_OSDSet_ledger</include>
		<include condition="!$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_ledger]">MS_DlgSet_ledger</include>
		<include condition="$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_bridge]">MS_OSDSet_bridge</include>
		<include condition="!$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_bridge]">MS_DlgSet_bridge</include>
		<include condition="$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_tabslab]">MS_OSDSet_tabslab</include>
		<include condition="!$EXP[Dlg_IsOSDSettings] + $EXP[Aeon_MS_tabslab]">MS_DlgSet_tabslab</include>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information (Aeon). Movie, episode, TV show, season and collection share one page;
	texts switch on ListItem.DBType (Includes_VideoInfo.xml, VidView_* in Includes_Views_Video.xml).

	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo, Omega source):
	  8 play (plays from the beginning when 9 exists; browses for tvshow/season/set)
	  9 resume (enabled by Kodi only with a resume point) | 11 play trailer | 50 cast list
	  (collections: the films of the set) | 6 refresh | 7 user rating | 10 choose art | 12 choose
	  fanart | 13 director search | 14 manage versions | 15 manage extras | 443 go to collection.
	Aeon ids: 9000 button row (default focus), 9001 story card (OK = full story), 9010 More,
	  9012 Browse / 9013 From start (both re-send 8), 9100 More row, 9200 full story overlay, 61 its scrollbar.

	Focus map: buttons 9000 -Down-> story 9001 -Down-> cast 50 (the page slides up 440 px while 50 has
	focus; 860 / 1280 px for the online rows 9301 Recommended and 9302 Similar under it). More -> 9100 row (replaces the lower cards; Up / Back return to More).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(aeon.leftmins,$VAR[AG_LeftMinsQ],home)</onload>
	<onload>ClearProperty(aeon.trailer,home)</onload>
	<onload>RunScript(script.aeon.helper,trailer,probe)</onload>
	<onunload>ClearProperty(aeon.trailer,home)</onunload>
	<onunload>ClearProperty(aeon.arttype,home)</onunload>
	<onload>SetProperty(aeon.vi.path,$ESCINFO[ListItem.FileNameAndPath],home)</onload>
	<onload>SetProperty(aeon.vi.secs,$INFO[ListItem.Duration(secs)],home)</onload>
	<onunload>ClearProperty(aeon.vi.path,home)</onunload>
	<onunload>ClearProperty(aeon.vi.secs,home)</onunload>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include condition="!$EXP[FGS]">VidInfo_PageClassic</include>
		<include condition="$EXP[FGS]">VidInfo_PageFGS</include>
	</controls>
</window>

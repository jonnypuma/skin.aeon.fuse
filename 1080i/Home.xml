	<onload condition="String.IsEmpty(Skin.String(aeon.menu.init))">Skin.SetString(aeon.menu.23,off)</onload>
	<onload condition="String.IsEmpty(Skin.String(aeon.menu.init))">Skin.SetString(aeon.menu.24,off)</onload>
	<onload condition="String.IsEmpty(Skin.String(aeon.menu.init))">Skin.SetString(aeon.menu.init,1)</onload>
	<!-- 0.56.20 splash: while the start-up splash shows, its button holds the focus (OK / Back: the menu) -->
	<onload condition="!String.IsEmpty(Window(Home).Property(aeon.splash))">SetFocus(9999)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(aeon.splash))">AlarmClock(aeonsplashto,SetProperty(aeon.splash.to,1,home),00:40,silent)</onload><!-- 0.56.53 40 s (user: "Wait for 10s more") -->
	<onunload>ClearProperty(aeon.splash,home)</onunload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Aeon_Home</include>
		<include>Aeon_Splash</include>
	</controls>
</window>

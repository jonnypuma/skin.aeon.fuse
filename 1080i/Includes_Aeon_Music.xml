<?xml version="1.0" encoding="UTF-8"?>
<!--
	Aeon 2 style music Now Playing. Reference notes: ../AEON2_DESIGN_NOTES.md ("Music Now Playing").

	A dark card on the left (artist / track / album / released / label), a thin audio wave across it,
	and a lighter grey block that grows from the left edge as the song progresses; elapsed + total at
	the bottom, codec + bitrate tag. Large cover art on the right, dimmed fanart behind.

	The wave is Kodi's visualisation control (id 2) clipped to the band inside the card: Kodi can only draw
	audio-reactive graphics through a visualisation add-on, so enable a waveform one
	(Settings > Player > Music > Visualisation, e.g. visualization.waveform) to see it.
-->
<includes>
	<constant name="aeon_np_x">140</constant>
	<constant name="aeon_np_y">190</constant>
	<constant name="aeon_np_w">820</constant>
	<constant name="aeon_np_h">700</constant>
	<!-- 0.52.1 Smooth song progress (on by default since 0.52.3): the helper (script.aeon.helper smoothprog.py) is
	     driving the card's fill 4801 -->
	<expression name="Aeon_SmoothProgress">!Skin.HasSetting(aeon.smoothprogress.off) + String.IsEqual(Window(Home).Property(aeon.smoothprog),1)</expression>

	<variable name="Aeon_NP_Fanart">
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),1) + !String.IsEmpty(Player.Art(artist.fanart1))">$INFO[Player.Art(artist.fanart1)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),1) + !String.IsEmpty(Player.Art(fanart1))">$INFO[Player.Art(fanart1)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),2) + !String.IsEmpty(Player.Art(artist.fanart2))">$INFO[Player.Art(artist.fanart2)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),2) + !String.IsEmpty(Player.Art(fanart2))">$INFO[Player.Art(fanart2)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),3) + !String.IsEmpty(Player.Art(artist.fanart3))">$INFO[Player.Art(artist.fanart3)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),3) + !String.IsEmpty(Player.Art(fanart3))">$INFO[Player.Art(fanart3)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),4) + !String.IsEmpty(Player.Art(artist.fanart4))">$INFO[Player.Art(artist.fanart4)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.npfan),4) + !String.IsEmpty(Player.Art(fanart4))">$INFO[Player.Art(fanart4)]</value>
		<value condition="!String.IsEmpty(Player.Art(fanart))">$INFO[Player.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Player.Art(artist.fanart))">$INFO[Player.Art(artist.fanart)]</value>
		<value>$INFO[Player.Art(thumb)]</value>
	</variable>
	<!-- 0.46.0: the main fanart under the cycling one (Aeon_NowPlaying), shown while the next picture loads -->
	<variable name="Aeon_NP_FanartBase">
		<value condition="!String.IsEmpty(Player.Art(fanart))">$INFO[Player.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Player.Art(artist.fanart))">$INFO[Player.Art(artist.fanart)]</value>
		<value>$INFO[Player.Art(thumb)]</value>
	</variable>
	<variable name="Aeon_NP_Disc">
		<value condition="!String.IsEmpty(Player.Art(album.discart))">$INFO[Player.Art(album.discart)]</value>
		<value condition="!String.IsEmpty(Player.Art(discart))">$INFO[Player.Art(discart)]</value>
		<value>$INFO[Player.Art(albumartist.discart)]</value>
	</variable>
	<!-- times of what is playing: big bold part . light part (minutes . seconds, or hours . minutes from one hour up) -->
	<variable name="Aeon_NP_Time">
		<value condition="Integer.IsGreater(Player.Duration(hh),0)">[B]$INFO[Player.Time(h)][/B]  ·  $INFO[Player.Time(mm)]  ·  [COLOR 99ffffff]$INFO[Player.Time(ss)][/COLOR]</value>
		<value>$INFO[Player.Time(m)]  ·  [COLOR 99ffffff]$INFO[Player.Time(ss)][/COLOR]</value>
	</variable>
	<variable name="Aeon_NP_Dur">
		<value condition="Integer.IsGreater(Player.Duration(hh),0)">[B]$INFO[Player.Duration(h)][/B]  ·  $INFO[Player.Duration(mm)]  ·  [COLOR 99ffffff]$INFO[Player.Duration(ss)][/COLOR]</value>
		<value>$INFO[Player.Duration(m)]  ·  [COLOR 99ffffff]$INFO[Player.Duration(ss)][/COLOR]</value>
	</variable>
	<variable name="Aeon_NP_Cover">
		<value condition="!String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
		<value>$INFO[Player.Art(album.thumb)]</value>
	</variable>
	<variable name="Aeon_NP_ArtistLogo">
		<value condition="!String.IsEmpty(Player.Art(artist.clearlogo))">$INFO[Player.Art(artist.clearlogo)]</value>
		<value>$INFO[Player.Art(clearlogo)]</value>
	</variable>
	<!-- audio quality line: codec | bit depth | sample rate | bit rate | channels; the tags of the song first, what the player
	     decodes when a tag is missing (streams, files outside the library) -->
	<variable name="Aeon_NP_Codec">
		<value condition="!String.IsEmpty(MusicPlayer.Codec)">[UPPERCASE]$INFO[MusicPlayer.Codec]$VAR[Aeon_NP_Bits]$VAR[Aeon_NP_Rate]$INFO[MusicPlayer.BitRate,  |  , $ADDON[skin.aeon.fuse 32209]]$INFO[MusicPlayer.Channels,  |  , $ADDON[skin.aeon.fuse 32210]][/UPPERCASE]</value>
		<value condition="!String.IsEmpty(Player.Process(audiodecoder))">[UPPERCASE]$INFO[Player.Process(audiodecoder)]$VAR[Aeon_NP_Bits]$VAR[Aeon_NP_Rate]$INFO[MusicPlayer.BitRate,  |  , $ADDON[skin.aeon.fuse 32209]]$INFO[MusicPlayer.Channels,  |  , $ADDON[skin.aeon.fuse 32210]][/UPPERCASE]</value>
	</variable>
	<variable name="Aeon_NP_Bits">
		<value condition="Integer.IsGreater(MusicPlayer.BitsPerSample,0)">$INFO[MusicPlayer.BitsPerSample,  |  , $ADDON[skin.aeon.fuse 32211]]</value>
		<value condition="Integer.IsGreater(Player.Process(audiobitspersample),0)">$INFO[Player.Process(audiobitspersample),  |  , $ADDON[skin.aeon.fuse 32211]]</value>
	</variable>
	<variable name="Aeon_NP_Rate">
		<value condition="!String.IsEmpty(MusicPlayer.SampleRate)">$INFO[MusicPlayer.SampleRate,  |  , $ADDON[skin.aeon.fuse 32212]]</value>
		<value condition="Integer.IsGreater(Player.Process(audiosamplerate),0)">$INFO[Player.Process(audiosamplerate),  |  , $ADDON[skin.aeon.fuse 32213]]</value>
	</variable>

	<include name="Aeon_NowPlaying">
		<!-- the visualisation first, full screen, exactly like Estuary (choose one in Settings > Player > Music > Visualisation);
		     everything above it is translucent so the wave shows through the fanart and the card -->
		<!-- 0.46.0: the main fanart under the cycling one, and the artist's other fanarts loaded ahead (1 px under the opaque layers) -->
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(artist.fanart1)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(fanart1)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(artist.fanart2)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(fanart2)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(artist.fanart3)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(fanart3)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(artist.fanart4)]</texture></control>
		<control type="image"><left>0</left><top>0</top><width>1</width><height>1</height><texture background="true">$INFO[Player.Art(fanart4)]</texture></control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>600</fadetime>
			<texture subpixel="true" mipmap="true" background="true" colordiffuse="ffb0b0b0">$VAR[Aeon_NP_FanartBase]</texture>
			<!-- the same slow zoom and drift as the Home spotlight pages; the picture changes every 16 s when the artist has more fanart -->
			<animation type="Conditional" condition="!Skin.HasSetting(aeon.reducemotion)" loop="true">
				<effect type="zoom" start="100" end="110" center="960,540" time="16000" tween="sine" easing="inout"/>
				<effect type="slide" start="0,0" end="-24,-10" time="16000" tween="sine" easing="inout"/>
				<effect type="zoom" start="100" end="90.91" center="960,540" delay="16000" time="16000" tween="sine" easing="inout"/>
				<effect type="slide" start="0,0" end="24,10" delay="16000" time="16000" tween="sine" easing="inout"/>
			</animation>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>1500</fadetime>
			<texture subpixel="true" mipmap="true" background="true" colordiffuse="ffb0b0b0">$VAR[Aeon_NP_Fanart]</texture>
			<!-- the same slow zoom and drift as the Home spotlight pages; the picture changes every 16 s when the artist has more fanart -->
			<animation type="Conditional" condition="!Skin.HasSetting(aeon.reducemotion)" loop="true">
				<effect type="zoom" start="100" end="110" center="960,540" time="16000" tween="sine" easing="inout"/>
				<effect type="slide" start="0,0" end="-24,-10" time="16000" tween="sine" easing="inout"/>
				<effect type="zoom" start="100" end="90.91" center="960,540" delay="16000" time="16000" tween="sine" easing="inout"/>
				<effect type="slide" start="0,0" end="24,10" delay="16000" time="16000" tween="sine" easing="inout"/>
			</animation>
		</control>

		<control type="multiimage">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<imagepath background="true" colordiffuse="b0ffffff">$INFO[Window(Home).Property(ArtistSlideshow)]</imagepath>
			<timeperimage>8000</timeperimage>
			<fadetime>1500</fadetime>
			<randomize>true</randomize>
			<loop>yes</loop>
			<visible>Skin.HasSetting(aeon.artistslideshow) + !String.IsEmpty(Window(Home).Property(ArtistSlideshow))</visible>
		</control>

		<!-- colour wash from the artwork (Kodi Fanart.Color1), as the Aeon music pages tint everything -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="$INFO[Fanart.Color1]">common/white.png</texture>
			<animation effect="fade" end="22" time="0" condition="true">Conditional</animation>
		</control>

		<!-- the card -->
		<control type="group">
			<left>aeon_np_x</left>
			<top>aeon_np_y</top>
			<!-- the player controls cover the lower part of the screen: the whole picture (card, text, cover, lyrics, disc) steps back
			     together to 84 %, anchored at the card's top left corner, so it ends above the controls (y 778) -->
			<animation effect="zoom" start="100" end="84" center="140,190" time="300" tween="cubic" easing="out" reversible="true" condition="Window.IsVisible(musicosd)">Conditional</animation>
			<animation type="WindowOpen" tween="cubic" easing="out" condition="!Skin.HasSetting(aeon.reducemotion)">
				<effect type="slide" start="-80" end="0" time="500"/>
				<effect type="fade" start="0" end="100" time="500"/>
			</animation>
			<animation type="WindowClose" tween="cubic" easing="in">
				<effect type="fade" start="100" end="0" time="200"/>
			</animation>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>aeon_np_w</width>
				<height>aeon_np_h</height>
				<texture colordiffuse="88101010">common/white.png</texture>
				<visible>!$EXP[Aeon_FGlass]</visible>
			</control>
			<!-- Fused Glass (0.39.7): a frosted r28 card; the song's progress revealed from the left inside the same shape -->
			<control type="image"><width>aeon_np_w</width><height>aeon_np_h</height><texture border="28" colordiffuse="$VAR[FG_Frost]">fg/r28.png</texture><visible>$EXP[Aeon_FGlass]</visible></control>
			<control type="progress"><width>aeon_np_w</width><height>aeon_np_h</height><reveal>true</reveal><texturebg border="28" colordiffuse="00ffffff">fg/r28.png</texturebg><midtexture subpixel="true" border="28" colordiffuse="24ffffff">fg/r28.png</midtexture><info>Player.Progress</info><visible>$EXP[Aeon_FGlass] + !$EXP[Aeon_SmoothProgress]</visible></control>
			<!-- 0.52.1 Skin settings > Motion, memory, reset > Smooth song progress: Kodi reads Player.Progress as a whole percent
			     (an 8 px step every 1 %); this twin has no <info>, the helper sets its percent as a fraction (as often as Kodi
			     draws the screen, or 10 / 25 / 30 / 60 times a second) and shows it by Window(Home).Property(aeon.smoothprog) -->
			<control type="progress" id="4801"><width>aeon_np_w</width><height>aeon_np_h</height><reveal>true</reveal><texturebg border="28" colordiffuse="00ffffff">fg/r28.png</texturebg><midtexture subpixel="true" border="28" colordiffuse="24ffffff">fg/r28.png</midtexture><visible>$EXP[Aeon_FGlass] + $EXP[Aeon_SmoothProgress]</visible></control>
			<control type="image"><width>aeon_np_w</width><height>aeon_np_h</height><texture border="28" colordiffuse="$VAR[FG_Edge]">fg/e28.png</texture><visible>$EXP[Aeon_FGlass]</visible></control>
			<!-- progress: a lighter block growing from the left edge across the whole card (35 bars of 20 px, drawn at 19 % together) -->
			<control type="group">
				<visible>!$EXP[Aeon_FGlass]</visible>
				<animation effect="fade" end="19" time="0" condition="true">Conditional</animation>
				<control type="progress">
					<left>0</left>
					<top>0</top>
					<width>aeon_np_w</width>
					<height>20</height>
					<reveal>true</reveal>
					<texturebg colordiffuse="00ffffff">common/aeon_fill_20.png</texturebg>
					<lefttexture></lefttexture>
					<midtexture subpixel="true">common/aeon_fill_20.png</midtexture>
					<righttexture subpixel="true"></righttexture>
					<overlaytexture></overlaytexture>
					<info>Player.Progress</info>
				</control>
				<control type="progress">
					<left>0</left>
					<top>20</top>
					<width>aeon_np_w</width>
					<height>20</height>
					<reveal>true</reveal>
					<texturebg colordiffuse="00ffffff">common/aeon_fill_20.png</texturebg>
					<lefttexture></lefttexture>
					<midtexture subpixel="true">common/aeon_fill_20.png</midtexture>
					<righttexture subpixel="true"></righttexture>
					<overlaytexture></overlaytexture>
					<info>Player.Progress</info>
				</control>
				<control type="progress">

<?xml version="1.0" encoding="UTF-8"?>
<!--
	Aeon style video OSD. NOTE: the Aeon 2 video never shows its player OSD, so this is built from Aeon's
	look (black, white uppercase, thin lines, white focus block, ring + "ENDS" from the resume screen at ~7:20)
	and is NOT a copy. Reference notes: ../AEON2_DESIGN_NOTES.md.

	Same Kodi id contract and focus map as the Aeon OSD (VideoOSD.xml): 602 play/pause (default), 603 stop,
	600 previous, 607 next, 70046 subtitles, 70049 audio, 70048 video, 70044 chapters, 70043 info, 70051 stats,
	87 hidden seek stepper (Up from any button; Down returns), group 200 = controls.
	The Aeon "Sleep after this" button (70060) is not carried over.
-->
<includes>
	<variable name="Aeon_OSD_Play">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">aeon/icons/play.png</value>
		<value>aeon/icons/pause.png</value>
	</variable>
	<!-- 0.39.10: a trailer started from an information page (helper trailer.play): while that very file plays, the
	     overlays show the show / film it belongs to (Window(Home) aeon.tr.*), not "Movies" and the file name -->
	<expression name="Aeon_OSD_Trailer">[!String.IsEmpty(Window(Home).Property(aeon.tr.now)) + String.IsEqual(Player.FilenameAndPath,Window(Home).Property(aeon.tr.now))]</expression>
	<variable name="Aeon_OSD_Logo">
		<value condition="$EXP[Aeon_OSD_Trailer]">$INFO[Window(Home).Property(aeon.tr.logo)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.clearlogo))">$INFO[Player.Art(tvshow.clearlogo)]</value>
		<value>$INFO[Player.Art(clearlogo)]</value>
	</variable>
	<expression name="Aeon_OSD_HasLogo">[!Skin.HasSetting(aeon.nologos) + [[$EXP[Aeon_OSD_Trailer] + !String.IsEmpty(Window(Home).Property(aeon.tr.logo))] | [!$EXP[Aeon_OSD_Trailer] + [!String.IsEmpty(Player.Art(tvshow.clearlogo)) | !String.IsEmpty(Player.Art(clearlogo))]]]]</expression>
	<variable name="Aeon_OSD_Kind">
		<value condition="$EXP[Aeon_OSD_Trailer] + String.IsEqual(Window(Home).Property(aeon.tr.kind),tvshow)">$LOCALIZE[31353]</value>
		<value condition="$EXP[Aeon_OSD_Trailer]">$LOCALIZE[31354]</value>
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$LOCALIZE[31353]</value>
		<value>$LOCALIZE[31354]</value>
	</variable>
	<variable name="Aeon_OSD_Title">
		<value condition="$EXP[Aeon_OSD_Trailer]">[UPPERCASE]$INFO[Window(Home).Property(aeon.tr.title)][/UPPERCASE]</value>
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">[UPPERCASE]$INFO[VideoPlayer.TVShowTitle][/UPPERCASE]</value>
		<value>[UPPERCASE]$INFO[VideoPlayer.Title][/UPPERCASE]</value>
	</variable>
	<variable name="Aeon_OSD_Sub">
		<value condition="$EXP[Aeon_OSD_Trailer]">[UPPERCASE]$INFO[Window(Home).Property(aeon.tr.title)]  |  $LOCALIZE[20410]  [/UPPERCASE]</value>
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle) + !String.IsEmpty(VideoPlayer.Episode)">$VAR[Aeon_EpCodeVP]  |  [UPPERCASE]$INFO[VideoPlayer.Title]  [/UPPERCASE]</value>
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">[UPPERCASE]$INFO[VideoPlayer.Title]  [/UPPERCASE]</value>
		<value>[UPPERCASE]$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Genre,  |  ][/UPPERCASE]</value>
	</variable>
	<variable name="Aeon_OSD_State">
		<value condition="Player.Caching">$LOCALIZE[31355]</value>
		<value condition="Player.Paused">$LOCALIZE[31356]</value>
		<value condition="Player.Forwarding | Player.Rewinding">$INFO[Player.SeekStepSize]</value>
	</variable>

	<!-- labels under the focused OSD button (0.26.0): KEY:  VALUE with the value in bold, or one bold word.
	     Drawn in the medium face, so the bold part stands out; uppercase in the button include. -->
	<variable name="Aeon_OSD_LblPlay">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">[B]$LOCALIZE[31278][/B]</value>
		<value>[B]$LOCALIZE[31048][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblShuffle">
		<value condition="Playlist.IsRandom">[COLOR a6ffffff]$LOCALIZE[31532]:[/COLOR]  [B]$LOCALIZE[31547][/B]</value>
		<value>[COLOR a6ffffff]$LOCALIZE[31532]:[/COLOR]  [B]$LOCALIZE[31548][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblRepeat">
		<value condition="Playlist.IsRepeatOne">[COLOR a6ffffff]$LOCALIZE[486]:[/COLOR]  [B]$LOCALIZE[592][/B]</value>
		<value condition="Playlist.IsRepeat">[COLOR a6ffffff]$LOCALIZE[486]:[/COLOR]  [B]$LOCALIZE[593][/B]</value>
		<value>[COLOR a6ffffff]$LOCALIZE[486]:[/COLOR]  [B]$LOCALIZE[31548][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblLyrics">
		<value>[COLOR a6ffffff]$LOCALIZE[31639]:[/COLOR]  [B]$VAR[Aeon_LyricsMode][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblPresets">
		<value condition="!String.IsEmpty(Visualisation.Preset)">[COLOR a6ffffff]$LOCALIZE[31638]:[/COLOR]  [B]$INFO[Visualisation.Preset][/B]</value>
		<value>[B]$LOCALIZE[31638][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblQueue">
		<value>[COLOR a6ffffff]$LOCALIZE[31045]:[/COLOR]  [B]$INFO[Playlist.Position(music)] / $INFO[Playlist.Length(music)][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblAlbum">
		<value condition="!String.IsEmpty(MusicPlayer.Album)">[COLOR a6ffffff]$LOCALIZE[558]:[/COLOR]  [B]$INFO[MusicPlayer.Album][/B]</value>
		<value>[B]$LOCALIZE[558][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblSubs">
		<value condition="!VideoPlayer.HasSubtitles">[B]$LOCALIZE[31347][/B]</value>
		<value condition="!VideoPlayer.SubtitlesEnabled">[COLOR a6ffffff]$LOCALIZE[31347]:[/COLOR]  [B]$LOCALIZE[31548][/B]</value>
		<value condition="!String.IsEmpty(VideoPlayer.SubtitlesLanguage)">[COLOR a6ffffff]$LOCALIZE[31347]:[/COLOR]  [B]$INFO[VideoPlayer.SubtitlesLanguage][/B]</value>
		<value>[COLOR a6ffffff]$LOCALIZE[31347]:[/COLOR]  [B]$LOCALIZE[31547][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblAudio">
		<value condition="!String.IsEmpty(VideoPlayer.AudioLanguage) | !String.IsEmpty(VideoPlayer.AudioCodec)">[COLOR a6ffffff]$LOCALIZE[31348]:[/COLOR]  [B]$INFO[VideoPlayer.AudioLanguage,,  ·  ]$VAR[OSD_FlagAudio][/B]</value>
		<value>[B]$LOCALIZE[31348][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblVideo">
		<value condition="!String.IsEmpty(VideoPlayer.VideoResolution)">[COLOR a6ffffff]$LOCALIZE[31349]:[/COLOR]  [B]$VAR[OSD_FlagResolution]$VAR[OSD_FlagVideoCodec,  ·  ,]$VAR[OSD_FlagHDR,  ·  ,][/B]</value>
		<value>[B]$LOCALIZE[31349][/B]</value>
	</variable>
	<variable name="Aeon_OSD_LblChapter">
		<value condition="Integer.IsGreater(Player.ChapterCount,0)">[COLOR a6ffffff]$LOCALIZE[21396]:[/COLOR]  [B]$INFO[Player.Chapter] / $INFO[Player.ChapterCount][/B]</value>
		<value condition="!Integer.IsGreater(Player.ChapterCount,1) + $EXP[OSD_HasSkChapters]">[COLOR a6ffffff]$LOCALIZE[21396]:[/COLOR]  [B]$INFO[Window(Home).Property(aeon.sk.part)] / $INFO[Window(Home).Property(aeon.sk.count)][/B]</value>
		<value>[B]$LOCALIZE[31350][/B]</value>
	</variable>

	<!-- Icon button (transport). params: id, icon, onclick, visible -->
	<include name="Aeon_OSD_IconBtn">
		<param name="visible">true</param>
		<param name="label"></param>
		<param name="onclick2">noop</param>
		<param name="nav">AeonV_</param>
		<param name="active">false</param>
		<definition>
			<control type="group">
				<width>90</width>
				<height>90</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>90</width>
					<height>90</height>
					<label></label>
					<include>FG_OSDIconTex</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onleft>$VAR[$PARAM[nav]Left$PARAM[id]]</onleft>
					<onright>$VAR[$PARAM[nav]Right$PARAM[id]]</onright>
					<onup condition="Player.SeekEnabled">87</onup>
					<ondown condition="$EXP[OSD_HasChapters]">ActivateWindow(videobookmarks)</ondown>
					<ondown condition="!$EXP[OSD_HasChapters]">noop</ondown>
				</control>
				<control type="image">
					<left>25</left>
					<top>25</top>
					<width>40</width>
					<height>40</height>
					<texture colordiffuse="ffffffff">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>25</left>
					<top>25</top>
					<width>40</width>
					<height>40</height>
					<texture colordiffuse="aeon_onbar">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<!-- the option is on (shuffle, repeat, lyrics): a short line under the icon -->
				<control type="image"><left>33</left><top>74</top><width>24</width><height>4</height><texture colordiffuse="ffffffff">common/white.png</texture><visible>[$PARAM[active]] + !Control.HasFocus($PARAM[id])</visible></control>
				<control type="image"><left>33</left><top>74</top><width>24</width><height>4</height><texture colordiffuse="aeon_onbar">common/white.png</texture><visible>[$PARAM[active]] + Control.HasFocus($PARAM[id])</visible></control>
				<!-- what the focused button does / is set to, under it (the row is 130 high: a grouplist clips its children) -->
				<control type="label">
					<left>-405</left><top>96</top><width>900</width><height>30</height><align>center</align><aligny>center</aligny>
					<font>pl_small_20</font><textcolor>ffffffff</textcolor><selectedcolor>ffffffff</selectedcolor>
					<scroll>true</scroll>
					<label>[UPPERCASE]$PARAM[label][/UPPERCASE]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Text button. params: id, w, label, onclick, visible -->
	<include name="Aeon_OSD_Btn">
		<param name="nav">AeonV_</param>
		<param name="w">130</param>
		<param name="label"></param>
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<width>$PARAM[w]</width>
				<height>90</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[w]</width>
					<height>90</height>
					<label>$PARAM[label]</label>
					<font>pl_cap_20</font>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>0</textoffsetx>
					<textcolor>ffffffff</textcolor><selectedcolor>ffffffff</selectedcolor>
					<focusedcolor>aeon_onbar</focusedcolor>
					<include>FG_OSDPillTex</include>
					<onclick>$PARAM[onclick]</onclick>
					<onleft>$VAR[$PARAM[nav]Left$PARAM[id]]</onleft>
					<onright>$VAR[$PARAM[nav]Right$PARAM[id]]</onright>
					<onup condition="Player.SeekEnabled">87</onup>
					<ondown condition="$EXP[OSD_HasChapters]">ActivateWindow(videobookmarks)</ondown>
					<ondown condition="!$EXP[OSD_HasChapters]">noop</ondown>
				</control>
			</control>
		</definition>
	</include>

	<!-- Controls row. A grouplist, so Left / Right skip hidden buttons by themselves. 130 high: the buttons are 90, the label
	     under the focused one needs the rest (a grouplist clips what is outside it). -->
	<include name="Aeon_OSD_Row">
		<control type="group" id="200">
			<left>477</left>
			<top>880</top>
			<width>1383</width>
			<height>130</height>
			<control type="grouplist">
				<left>-477</left>
				<top>0</top>
				<width>1920</width>
				<height>130</height>
				<orientation>horizontal</orientation>
				<itemgap>4</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<!-- an empty start: the row runs from the screen's left edge, so the first button's label has room on its left
				     (a grouplist cuts off whatever reaches past its edges) -->
				<control type="group"><width>473</width><height>130</height></control>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="600"/>
					<param name="label" value="[B]$LOCALIZE[31121][/B]"/>
					<param name="icon" value="aeon/icons/prev.png"/>
					<param name="onclick" value="PlayerControl(Previous)"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="601"/>
					<param name="label" value="[B]$LOCALIZE[31122][/B]"/>
					<param name="icon" value="aeon/icons/rewind.png"/>
					<param name="onclick" value="PlayerControl(Rewind)"/>
					<param name="visible" value="Player.SeekEnabled"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="602"/>
					<param name="label" value="$VAR[Aeon_OSD_LblPlay]"/>
					<param name="icon" value="$VAR[Aeon_OSD_Play]"/>
					<param name="onclick" value="PlayerControl(Play)"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="606"/>
					<param name="label" value="[B]$LOCALIZE[31125][/B]"/>
					<param name="icon" value="aeon/icons/forward.png"/>
					<param name="onclick" value="PlayerControl(Forward)"/>
					<param name="visible" value="Player.SeekEnabled"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="607"/>
					<param name="label" value="[B]$LOCALIZE[31126][/B]"/>
					<param name="icon" value="aeon/icons/next.png"/>
					<param name="onclick" value="PlayerControl(Next)"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="603"/>
					<param name="label" value="[B]$LOCALIZE[31124][/B]"/>
					<param name="icon" value="aeon/icons/stop.png"/>
					<param name="onclick" value="PlayerControl(Stop)"/>
				</include>
				<control type="group"><width>26</width><height>90</height></control>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70046"/>
					<param name="label" value="$VAR[Aeon_OSD_LblSubs]"/>
					<param name="icon" value="aeon/icons/subtitles.png"/>
					<param name="onclick" value="ActivateWindow(osdsubtitlesettings)"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70049"/>
					<param name="label" value="$VAR[Aeon_OSD_LblAudio]"/>
					<param name="icon" value="aeon/icons/audio.png"/>
					<param name="onclick" value="ActivateWindow(osdaudiosettings)"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70048"/>
					<param name="label" value="$VAR[Aeon_OSD_LblVideo]"/>
					<param name="icon" value="common/aeon_ic_screen.png"/>
					<param name="onclick" value="ActivateWindow(osdvideosettings)"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70044"/>
					<param name="label" value="$VAR[Aeon_OSD_LblChapter]"/>
					<param name="icon" value="aeon/icons/chapters.png"/>
					<param name="onclick" value="ActivateWindow(videobookmarks)"/>
					<param name="visible" value="$EXP[OSD_HasChapters]"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70043"/>
					<param name="label" value="[B]$LOCALIZE[31351][/B]"/>
					<param name="icon" value="aeon/icons/info.png"/>
					<param name="onclick" value="Action(Info,fullscreenvideo)"/>
				</include>
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70051"/>
					<param name="label" value="[B]$LOCALIZE[31352][/B]"/>
					<param name="icon" value="common/aeon_ic_stats.png"/>
					<param name="onclick" value="Action(PlayerProcessInfo)"/>
					<param name="visible" value="!System.AddonIsEnabled(script.tinyppi)"/>
				</include>
				<!-- tinyPPI (optional add-on): playback info of the player and the display chain -->
				<include content="Aeon_OSD_IconBtn">
					<param name="id" value="70052"/>
					<param name="label" value="[B]$LOCALIZE[31352][/B]"/>
					<param name="icon" value="aeon/icons/ppi.png"/>
					<param name="onclick" value="CancelAlarm(osd_timeout,true)"/>
					<param name="onclick2" value="RunScript(script.tinyppi,dialog)"/>
					<param name="visible" value="System.AddonIsEnabled(script.tinyppi)"/>
				</include>
			</control>
		</control>
	</include>

	<!-- poster beside the ring: the season's, the show's when the season has none (or its "poster" is a landscape picture:
	     the helper sets aeon.osd.noseasonposter, 0.39.8), else the film's -->
	<variable name="Aeon_OSD_Poster">
		<value condition="$EXP[Aeon_OSD_Trailer] + !String.IsEmpty(Window(Home).Property(aeon.tr.poster))">$INFO[Window(Home).Property(aeon.tr.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(season.poster)) + String.IsEmpty(Window(Home).Property(aeon.osd.noseasonposter))">$INFO[Player.Art(season.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.poster))">$INFO[Player.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(poster))">$INFO[Player.Art(poster)]</value>
		<value>$INFO[Player.Art(thumb)]</value>
	</variable>
	<!-- the top bar of the player overlays (Video OSD, information, chapters): as tall as the clock box, with the clock box
	     and the weather box under it as everywhere else (Skin settings > Playback can switch each off) and Skippy's next
	     episode beside the clock. Each window draws its own text on the left. -->
	<include name="Aeon_OSD_TopBar">
		<control type="image"><left>0</left><top>0</top><width>1920</width><height>108</height><texture colordiffuse="e6000000">common/white.png</texture><visible>!$EXP[Aeon_FGlass]</visible></control>
		<control type="image"><left>0</left><top>0</top><width>1920</width><height>260</height><texture colordiffuse="cc000000">fg/scrim_t.png</texture><visible>$EXP[Aeon_FGlass]</visible></control>
		<control type="group">
			<visible>!Skin.HasSetting(aeon.osd.noclock) + !$EXP[Aeon_FGlass]</visible>
			<include>Aeon_ClockBox</include>
		</control>
		<control type="group">
			<visible>!Skin.HasSetting(aeon.osd.noclock) + $EXP[Aeon_FGlass]</visible>
			<include>FG_ClockCapsule</include>
		</control>
		<control type="group">
			<left>1820</left>
			<top>108</top>
			<visible>!Skin.HasSetting(aeon.osd.noweather) + !String.IsEmpty(Weather.Temperature) + !$EXP[Aeon_FGlass]</visible>
			<animation effect="slide" end="0,-108" time="0" condition="Skin.HasSetting(aeon.osd.noclock)">Conditional</animation>
			<control type="image"><left>0</left><top>0</top><width>100</width><height>108</height><texture colordiffuse="cc0d0d0d">common/white.png</texture></control>
			<control type="image"><left>30</left><top>16</top><width>40</width><height>40</height><aspectratio>keep</aspectratio><texture colordiffuse="ffffffff">$VAR[AG_WeatherIcon]</texture></control>
			<control type="label"><left>0</left><top>60</top><width>100</width><height>36</height><align>center</align><font>pl_small_20_bold</font><textcolor>ccffffff</textcolor><selectedcolor>ccffffff</selectedcolor><label>$INFO[Weather.Temperature]</label></control>
		</control>
		<!-- Skippy: the next episode it found, in the bar beside the clock box (Skin settings > Behaviour) -->
		<control type="group">
			<visible>!Skin.HasSetting(aeon.skippy.nonext) + !String.IsEmpty(Window(Home).Property(Skippy.NextEpisode.Label)) + !$EXP[Aeon_FGlass]</visible>
			<animation effect="slide" end="100,0" time="0" condition="Skin.HasSetting(aeon.osd.noclock) + [Skin.HasSetting(aeon.osd.noweather) | String.IsEmpty(Weather.Temperature)] + !$EXP[Aeon_FGlass]">Conditional</animation>
			<animation effect="slide" end="-236,0" time="0" condition="!Skin.HasSetting(aeon.osd.noclock) + $EXP[Aeon_FGlass]">Conditional</animation>
			<animation effect="slide" end="100,0" time="0" condition="Skin.HasSetting(aeon.osd.noclock) + $EXP[Aeon_FGlass]">Conditional</animation>
			<control type="image">
				<left>1636</left><top>9</top><width>160</width><height>90</height>
				<aspectratio>scale</aspectratio>
				<texture background="true">$INFO[Window(Home).Property(Skippy.NextEpisode.Thumb)]</texture>
				<visible>!String.IsEmpty(Window(Home).Property(Skippy.NextEpisode.Thumb))</visible>
			</control>
			<control type="group">
				<animation effect="slide" end="184,0" time="0" condition="String.IsEmpty(Window(Home).Property(Skippy.NextEpisode.Thumb))">Conditional</animation>
				<control type="label">
					<left>912</left><top>20</top><width>700</width><height>30</height><align>right</align>
					<font>pl_cap_20</font><textcolor>99ffffff</textcolor><selectedcolor>99ffffff</selectedcolor>
					<label>[UPPERCASE]$LOCALIZE[31235][/UPPERCASE]</label>
				</control>
				<control type="label">
					<left>912</left><top>50</top><width>700</width><height>40</height><align>right</align>
					<font>pl_ui_26</font><textcolor>ffffffff</textcolor><selectedcolor>ffffffff</selectedcolor>
					<label>$INFO[Window(Home).Property(Skippy.NextEpisode.Label)]</label>
				</control>
			</control>
		</control>
	</include>
	<!-- Kodi scales a progress bar's fill by the height of its background texture: both are exactly as tall as the line
	     (aeon/line2.png, line4.png), or the fill comes out taller and below the line (it did, with no background texture). -->
	<!-- the seek line of the player overlays: a thin line, the white fill to where playback is (or where a step seek is
	     heading: Player.SeekBar moves with every Left / Right press, before the seek happens) and the marker, a white
	     square that hovers over the line. The slider is exactly as wide as the line, so its centre follows the fill
	     (Kodi keeps the 40 px marker inside the slider at the very start and end). params: left, top (line), width -->
	<include name="Aeon_SeekLine">
		<param name="left">477</param>
		<param name="top">856</param>
		<param name="width">1383</param>
		<param name="thick">Control.HasFocus(87)</param>
		<definition>
			<!-- Fused Glass (0.45.1): the player card's bar with gaps between chapters, as in the Video OSD -->
			<control type="group">

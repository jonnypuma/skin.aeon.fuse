<?xml version="1.0" encoding="UTF-8"?>
<!--
	Playback building blocks (Builder D, M3): VideoOSD, DialogSeekBar, DialogFullScreenInfo,
	DialogPlayerProcessInfo, DialogSlider (offset strip), DialogSubtitles, VideoOSDBookmarks,
	PlayerControls. Mockups: docs/mockups/OSD / Seek / Offset / SubDownload .dc.html.

	Rules: no panels over the picture (one top + one bottom scrim only), mono captions, outlined
	typographic media flags (DESIGN 7.8), accent only for "where you are" (played part, Play
	button, kicker, focus frame). Kodi 21 Omega infolabels only (checked against Kodi Omega
	source: PlayerGUIInfo.cpp / GUIInfoManager.cpp, and reference/ skins).

	Playhead / ticks use media/osd/* generated by _src/make_osd_textures.py (see its header for
	the slider-nib and ranges sizing maths).

	Legacy M1 includes OSD_Gradients / OSD_Progress / OSD_Title / OSD_IconButton are kept at the
	bottom so other builders (MusicOSD) can still use them.
-->
<includes>
	<!-- ============================================================= constants -->
	<constant name="osd_box">72</constant>
	<constant name="osd_box_f">88</constant>              <!-- osd_box + 16: button row height incl. focus-frame room -->                <!-- transport box (OSD.dc.html) -->
	<constant name="osd_box_gap">14</constant>
	<constant name="osd_box_icon">28</constant>
	<constant name="osd_box_icon_pos">22</constant>       <!-- (72 - 28) / 2 -->
	<constant name="osd_title_top">652</constant>         <!-- OSD title block -->
	<constant name="osd_track_top">806</constant>         <!-- OSD progress track -->
	<constant name="osd_buttons_top">900</constant>       <!-- OSD control row -->
	<constant name="osd_bubble_w">120</constant>
	<constant name="osd_bubble_h">30</constant>
	<constant name="osd_bubble_left">36</constant>        <!-- page margin - half the bubble -->

	<!-- =========================================================== expressions -->
	<!-- A playback dialog covers the OSD: hide the OSD chrome underneath (Tracks/AVSettings/
	     SubDownload/Offset mockups all show a clean frame + their own panel). -->
	<expression name="OSD_PanelOpen">[$EXP[OSDPanelOpen] | Window.IsVisible(selectdialog) | Window.IsVisible(subtitlesearch) | Window.IsVisible(fullscreeninfo) | Window.IsVisible(movieinformation) | Window.IsVisible(contextmenu)]</expression>
	<!-- The seek bar steps aside for the OSD / info (they draw their own progress) and for dialogs.
	     Process info keeps the bar (it sits top-left, the bar bottom). -->
	<expression name="OSD_SeekBarHidden">[Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Window.IsVisible(sliderdialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(osdcmssettings) | Window.IsVisible(videobookmarks) | Window.IsVisible(selectdialog) | Window.IsVisible(subtitlesearch) | Window.IsVisible(movieinformation)]</expression>
	<expression name="OSD_HasChapters">Integer.IsGreater(Player.ChapterCount,1)</expression>
	<expression name="OSD_HasSkChapters">!$EXP[OSD_HasChapters] + !String.IsEmpty(Window(Home).Property(aeon.sk.ranges))</expression><!-- 0.56.49 Skippy's segments as chapters -->
	<expression name="OSD_HasPrevNext">[Integer.IsGreater(Player.ChapterCount,1) | Integer.IsGreater(Playlist.Length(video),1) | Player.HasSceneMarkers]</expression>
	<expression name="OSD_SeekActive">[Player.Seeking | Player.HasPerformedSeek(3) | !String.IsEmpty(Player.SeekNumeric)]</expression>
	<expression name="OSD_HasNext">!String.IsEmpty(VideoPlayer.offset(1).Title) + Window.IsActive(fullscreenvideo)</expression>
	<expression name="OSD_OffsetBarBottom">String.IsEqual(Skin.String(aeon.offsetbar),bottom)</expression>

	<!-- ============================================================= variables -->
	<variable name="OSD_Speed">
		<value condition="Player.Forwarding2x | Player.Rewinding2x">2x</value>
		<value condition="Player.Forwarding4x | Player.Rewinding4x">4x</value>
		<value condition="Player.Forwarding8x | Player.Rewinding8x">8x</value>
		<value condition="Player.Forwarding16x | Player.Rewinding16x">16x</value>
		<value condition="Player.Forwarding32x | Player.Rewinding32x">32x</value>
	</variable>
	<variable name="OSD_Type">
		<value condition="VideoPlayer.Content(episodes)">$LOCALIZE[20359]</value>
		<value condition="VideoPlayer.Content(movies)">$LOCALIZE[20338]</value>
		<value condition="VideoPlayer.Content(musicvideos)">$LOCALIZE[31558]</value>
		<value condition="VideoPlayer.Content(livetv)">$LOCALIZE[31201]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$LOCALIZE[249]</value>
		<value>$LOCALIZE[291]</value>
	</variable>
	<variable name="OSD_Title">
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<!-- the episode code in the format of Skin settings > Episode code -->
	<variable name="OSD_EpisodeCode">
		<value>$VAR[Aeon_EpCodeVP]</value>
	</variable>
	<!-- Kodi stores US certifications as "Rated PG-13" (DATA.md 4.1): show the bare code -->
	<variable name="OSD_MPAA">
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated R)">R</value>
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated PG)">PG</value>
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated G)">G</value>
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated NR)">NR</value>
		<value condition="String.IsEqual(VideoPlayer.mpaa,Rated NC-17)">NC-17</value>
		<value>$INFO[VideoPlayer.mpaa]</value>
	</variable>
	<!-- Mono meta line under the title (font is uppercase) -->
	<variable name="OSD_Meta">
		<value condition="VideoPlayer.Content(episodes)">$VAR[OSD_EpisodeCode]$INFO[VideoPlayer.Title,  ·  ,]$INFO[VideoPlayer.Year,  ·  ,]</value>
		<value condition="VideoPlayer.Content(musicvideos)">$INFO[VideoPlayer.Artist]$INFO[VideoPlayer.Album,  ·  ,]$INFO[VideoPlayer.Year,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value condition="!String.IsEmpty(VideoPlayer.Year)">$INFO[VideoPlayer.Year]$VAR[OSD_MPAA,  ·  ,]$INFO[VideoPlayer.Director,  ·  ,]</value>
		<value>$VAR[OSD_MPAA]$INFO[VideoPlayer.Director,  ·  ,]</value>
	</variable>
	<!-- One-line title for the minimal seek bar -->
	<variable name="OSD_ShortTitle">
		<value condition="VideoPlayer.Content(episodes)">$VAR[OSD_Title]$VAR[OSD_EpisodeCode,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]$INFO[MusicPlayer.Artist,  ·  ,]</value>
		<value>$VAR[OSD_Title]</value>
	</variable>
	<!-- Next item (TV next episode / playlist), DialogFullScreenInfo -->
	<variable name="OSD_NextLabel">
		<value condition="VideoPlayer.Content(episodes)">$VAR[Aeon_EpCodeVPN]$INFO[VideoPlayer.offset(1).Title,  ·  ,]</value>
		<value>$INFO[VideoPlayer.offset(1).Title]$INFO[VideoPlayer.offset(1).Year,  ·  ,]</value>
	</variable>

	<!-- Time shown at the playhead / as elapsed: the seek target while seeking -->
	<variable name="OSD_SeekTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]</value>
		<value>$INFO[Player.Time]</value>
	</variable>
	<!-- "+30s" skip feedback (step size while stepping, offset after the seek). Under a minute the
	     (mm) part is +00/-00, so (ss) is the whole value. -->
	<variable name="OSD_SkipValue">
		<value condition="!String.IsEmpty(Player.SeekStepSize) + Integer.IsEqual(Player.SeekStepSize(mm),0)">$INFO[Player.SeekStepSize(ss)]s</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Integer.IsEqual(Player.SeekOffset(mm),0)">$INFO[Player.SeekOffset(ss)]s</value>
		<value condition="!String.IsEmpty(Player.SeekOffset)">$INFO[Player.SeekOffset]</value>
	</variable>

	<!-- Media flags (DESIGN 7.8, values per Kodi Omega VideoGUIInfo / ffmpeg codec names) -->
	<variable name="OSD_FlagResolution">
		<value condition="String.IsEqual(VideoPlayer.VideoResolution,4K) | String.IsEqual(VideoPlayer.VideoResolution,8K) | String.IsEqual(VideoPlayer.VideoResolution,SD)">$INFO[VideoPlayer.VideoResolution]</value>
		<value condition="!String.IsEmpty(VideoPlayer.VideoResolution)">$INFO[VideoPlayer.VideoResolution]P</value>
	</variable>
	<variable name="OSD_FlagVideoCodec">
		<value condition="[String.IsEqual(VideoPlayer.VideoCodec,h264) | String.IsEqual(VideoPlayer.VideoCodec,x264) | String.IsEqual(VideoPlayer.VideoCodec,avc) | String.IsEqual(VideoPlayer.VideoCodec,avc1) | String.IsEqual(VideoPlayer.VideoCodec,h.264)] | String.IsEqual(VideoPlayer.VideoCodec,avc1)">H.264</value>
		<value condition="[String.IsEqual(VideoPlayer.VideoCodec,hevc) | String.IsEqual(VideoPlayer.VideoCodec,x265) | String.IsEqual(VideoPlayer.VideoCodec,h265) | String.IsEqual(VideoPlayer.VideoCodec,h.265) | String.IsEqual(VideoPlayer.VideoCodec,hev1) | String.IsEqual(VideoPlayer.VideoCodec,hvc1)] | String.IsEqual(VideoPlayer.VideoCodec,h265) | String.IsEqual(VideoPlayer.VideoCodec,hvc1)">$LOCALIZE[31559]</value>
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,mpeg2video)">MPEG-2</value>
		<value condition="[String.IsEqual(VideoPlayer.VideoCodec,vc1) | String.IsEqual(VideoPlayer.VideoCodec,vc-1) | String.IsEqual(VideoPlayer.VideoCodec,wvc1)] | String.IsEqual(VideoPlayer.VideoCodec,wvc1)">VC-1</value>
		<value condition="[String.IsEqual(VideoPlayer.VideoCodec,mpeg4) | String.IsEqual(VideoPlayer.VideoCodec,xvid) | String.IsEqual(VideoPlayer.VideoCodec,divx) | String.IsEqual(VideoPlayer.VideoCodec,dx50)] | String.IsEqual(VideoPlayer.VideoCodec,xvid) | String.IsEqual(VideoPlayer.VideoCodec,divx)">MPEG-4</value>
		<value>$INFO[VideoPlayer.VideoCodec]</value>
	</variable>
	<variable name="OSD_FlagHDR">
		<value condition="[String.IsEqual(VideoPlayer.HdrType,dolbyvision) | String.IsEqual(VideoPlayer.HdrType,dv) | String.IsEqual(VideoPlayer.HdrType,dovi)]">$LOCALIZE[31560]</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10plus)">HDR10+</value>
		<value condition="[String.IsEqual(VideoPlayer.HdrType,hdr10) | String.IsEqual(VideoPlayer.HdrType,hdr)]">HDR10</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hlg)">HLG</value>
		<value>$INFO[VideoPlayer.HdrType]</value>
	</variable>
	<variable name="OSD_AudioCodec">
		<value condition="String.Contains(VideoPlayer.AudioCodec,truehd) + String.Contains(VideoPlayer.AudioCodec,atmos)">$LOCALIZE[31561]</value>
		<value condition="String.Contains(VideoPlayer.AudioCodec,eac3) + String.Contains(VideoPlayer.AudioCodec,atmos)">$LOCALIZE[31562]</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,dtshd_ma_x) | String.IsEqual(VideoPlayer.AudioCodec,dtsx) | String.IsEqual(VideoPlayer.AudioCodec,dts-x)">DTS:X</value>
		<value condition="[String.IsEqual(VideoPlayer.AudioCodec,truehd) | String.StartsWith(VideoPlayer.AudioCodec,truehd)]">TrueHD</value>
		<value condition="[String.IsEqual(VideoPlayer.AudioCodec,eac3) | String.IsEqual(VideoPlayer.AudioCodec,e-ac-3) | String.IsEqual(VideoPlayer.AudioCodec,eac-3) | String.StartsWith(VideoPlayer.AudioCodec,eac3)]">DD+</value>
		<value condition="[String.IsEqual(VideoPlayer.AudioCodec,ac3) | String.IsEqual(VideoPlayer.AudioCodec,ac-3) | String.IsEqual(VideoPlayer.AudioCodec,a52)]">DD</value>
		<value condition="[String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma) | [String.StartsWith(VideoPlayer.AudioCodec,dts-hd) + String.EndsWith(VideoPlayer.AudioCodec,ma)]]">$LOCALIZE[31446]</value>
		<value condition="[String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra) | [String.StartsWith(VideoPlayer.AudioCodec,dts-hd) + String.EndsWith(VideoPlayer.AudioCodec,hra)]]">$LOCALIZE[31447]</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,dca) | [String.IsEqual(VideoPlayer.AudioCodec,dts) | String.IsEqual(VideoPlayer.AudioCodec,dca)]">DTS</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,pcm) | String.IsEqual(VideoPlayer.AudioCodec,lpcm)">PCM</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,aac_he)">HE-AAC</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,aac) | String.IsEqual(VideoPlayer.AudioCodec,mp4a)">AAC</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,mp3) | String.IsEqual(VideoPlayer.AudioCodec,mp3float)">MP3</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,mp2) | String.IsEqual(VideoPlayer.AudioCodec,mp1)">MP2</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,opus)">Opus</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,vorbis)">Vorbis</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,flac)">FLAC</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,alac)">ALAC</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,wma)">WMA</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,ac4)">AC-4</value>
		<value>$INFO[VideoPlayer.AudioCodec]</value>
	</variable>
	<variable name="OSD_AudioChannels">
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,8)">7.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,7)">6.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,6)">5.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,5)">4.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,4)">4.0</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,3)">2.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,2)">2.0</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,1)">1.0</value>
	</variable>
	<variable name="OSD_FlagAudio">
		<value>$VAR[OSD_AudioCodec]$VAR[OSD_AudioChannels, ,]</value>
	</variable>

	<!-- OSD right-hand button values -->
	<variable name="OSD_SubtitleValue">
		<value condition="VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">$INFO[VideoPlayer.SubtitlesLanguage]</value>
		<value condition="VideoPlayer.SubtitlesEnabled">$LOCALIZE[31547]</value>
		<value condition="VideoPlayer.HasSubtitles">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[231]</value>
	</variable>
	<!-- PlayerControls -->
	<variable name="OSD_PlayerArt">
		<value condition="!String.IsEmpty(Player.Art(poster))">$INFO[Player.Art(poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.poster))">$INFO[Player.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
		<value>$INFO[Player.Icon]</value>
	</variable>
	<!-- Process info: decoder HW/SW, HDR or SDR -->
	<variable name="OSD_DecoderType">
		<value condition="Player.Process(videohwdecoder)">HW</value>
		<value>SW</value>
	</variable>
	<variable name="OSD_DynamicRange">
		<value condition="!String.IsEmpty(VideoPlayer.HdrType)">$VAR[OSD_FlagHDR]</value>
		<value>SDR</value>
	</variable>


	<!-- ============================================================= bookmarks -->
	<!-- the Trickplay picture of a chapter / bookmark, a fallback under Kodi's own picture (ListItem.Art(thumb) stays on
	     top and wins when it loads). The helper's service crops every chapter when the video starts (<prefix>c<N>.jpg),
	     the dialog its bookmarks (<prefix>b<resumepoint>.jpg); aeon.chap.prefix only names the folder and file token.
	     A variable: in a list's item layout a texture resolves a plain $INFO[Window(Home).Property(..)] against the item
	     and gets nothing. The item works out the path once, when first drawn, so the prefix is set before the dialog opens. -->
	<variable name="OSD_ChapThumb">
		<value condition="!String.IsEmpty(Window(Home).Property(aeon.chap.prefix)) + !String.IsEmpty(ListItem.Property(chapter))">$INFO[Window(Home).Property(aeon.chap.prefix)]c$INFO[ListItem.Property(chapter)].jpg</value>
		<value condition="!String.IsEmpty(Window(Home).Property(aeon.chap.prefix))">$INFO[Window(Home).Property(aeon.chap.prefix)]b$INFO[ListItem.Property(resumepoint)].jpg</value>
	</variable>
	<!-- One VideoOSDBookmarks thumb (item 344 x 290; thumb 320 x 180 at 8,12 so the focus frame
	     is not clipped by the panel). No art -> raised block with the time. param label_color -->
	<include name="OSD_BookmarkItem">
		<param name="label_color">$VAR[AG_Ink2]</param>
		<definition>
			<!-- Fused Glass (0.35.0): a soft shadow under the rounded thumb and a fine light edge round it -->
			<control type="image"><left>-32</left><top>-20</top><width>400</width><height>260</height><texture border="56" colordiffuse="b3000000">fg/sh16.png</texture><visible>$EXP[Aeon_FGlass]</visible></control>
			<control type="image">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>

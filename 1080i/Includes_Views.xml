	<variable name="AG_RowLabel">
		<value condition="ListItem.IsParentFolder">$LOCALIZE[31245]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="AG_RowIcon">
		<value condition="ListItem.IsParentFolder">aeon/icons/back.png</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.fart.dbid),ListItem.DBID) + String.IsEqual(Window(Home).Property(aeon.fart.type),ListItem.DBType) + !String.IsEmpty(Window(Home).Property(aeon.fart.thumb))">$INFO[Window(Home).Property(aeon.fart.thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="String.IsEqual(Window(Home).Property(aeon.fart.dbid),ListItem.DBID) + String.IsEqual(Window(Home).Property(aeon.fart.type),ListItem.DBType) + !String.IsEmpty(Window(Home).Property(aeon.fart.poster))">$INFO[Window(Home).Property(aeon.fart.poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ============================================================ View 50 (generic) -->
	<!-- 0.56.30 fgs_round2: the add-on browser's list in the Fused Glass style -->
	<!-- 0.56.37 fgs_addons -->
	<include name="FGS_AddonRow">
		<param name="focused">false</param>
		<param name="wide">false</param>
		<definition>
			<control type="image"><left>0</left><top>69</top><width>1180</width><height>1</height><texture colordiffuse="12ffffff">common/white.png</texture></control>
			<control type="image"><left>450</left><top>0</top><width>1</width><height>70</height><texture colordiffuse="1affffff">common/white.png</texture></control>

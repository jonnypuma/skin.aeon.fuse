<?xml version="1.0" encoding="UTF-8"?>
<!--
	Generic list window + view 50 for every media window that is not the video/music library
	(programs, pictures, add-ons, files, PVR lists...). Same Aeon layout as Films: a detail panel
	on the left, a soft card with the list on the right, header pills (9000) in the card.
	Kodi media-window ids: 3 sort by, 4 sort order, 10 watched toggle (video windows), views in <views>.
-->
<includes>
	<!-- One list row inside a card (1076 wide, 76 high). params: focused, id -->
	<include name="AG_LibListRow">
		<param name="focused">false</param>
		<param name="id">50</param>
		<param name="w">1134</param>
		<param name="l2">858</param>
		<definition>
			<control type="image"><left>0</left><top>0</top><right>0</right><bottom>0</bottom><texture border="20" colordiffuse="10ffffff">aeon/card_row.png</texture><visible>$EXP[Aeon_Fused]</visible></control>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1126</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[AG_Accent]">$VAR[Aeon_TexCard20]</texture>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id]) + $EXP[Aeon_VGlass] + !$EXP[Aeon_FGlass]</visible>
			</control>
			<!-- Fused Glass (0.54.3): 12 px inside the row, in the focus bar's r16 shape -->
			<control type="image"><left>12</left><top>4</top><right>12</right><height>68</height><texture border="20" colordiffuse="$VAR[AG_Accent]">$VAR[Aeon_MenuFocusRowTex]</texture><visible>$PARAM[focused] + Control.HasFocus($PARAM[id]) + $EXP[Aeon_FGlass]</visible></control>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1126</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[AG_Raised]">$VAR[Aeon_TexCard20]</texture>
				<visible>$PARAM[focused] + !Control.HasFocus($PARAM[id]) + $EXP[Aeon_VGlass] + !$EXP[Aeon_FGlass]</visible>
			</control>
			<!-- Fused Glass (0.54.3): 12 px inside the row, in the focus bar's r16 shape -->

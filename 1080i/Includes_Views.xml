				<left>22</left>
				<top>14</top>
				<width>48</width>
				<height>48</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="fg/m48x48.png">$VAR[AG_RowIcon]</texture>
				<visible>$EXP[Aeon_FGlass]</visible>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>
				<font>lb_ui_24</font>
				<textcolor>$VAR[AG_Ink]</textcolor><selectedcolor>$VAR[AG_Ink]</selectedcolor>
				<label>$VAR[AG_RowLabel]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>

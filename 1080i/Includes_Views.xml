			</control>
			<control type="label">
				<left>$PARAM[l2]</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>lb_small_20</font>
				<textcolor>$VAR[AG_Ink2]</textcolor><selectedcolor>$VAR[AG_Ink2]</selectedcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>$PARAM[l2]</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>lb_small_20</font>
				<textcolor>$VAR[AG_OnAccent]</textcolor><selectedcolor>$VAR[AG_OnAccent]</selectedcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
		</definition>
	</include>

<?xml version="1.0" encoding="UTF-8"?>
<!--
	TV / Radio guide (SPEC 5: Minimal). Builder F, M4. One plain EPG grid (channels as rows, time
	across) with the selected programme's details underneath. PVR is unused by Omar: correct,
	readable, never stranding.
	Kodi id contract (Estuary Omega MyPVRGuide.xml + GUIWindowPVRBase.h): epggrid view container 50
	(Estuary's alternative grids 51-53 are not offered), scrollbar 60, menucontrol 9000, sort 3 / 4,
	channel-group button 28, header labels 29 / 30. Inside the grid layouts, label 1 / image 2 are
	the controls Kodi stretches to each programme's width. Estuary's channel-group strip (list 11)
	is replaced by the Group button in the options row (6054 -> 28).
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<!-- 0.39.3: opened with Left / Right on the area tabs: the focus stays on the tabs -->
	<onload condition="!String.IsEmpty(Window(Home).Property(aeon.pvrnav))">SetFocus(101)</onload>
	<onload>ClearProperty(aeon.pvrnav,home)</onload>
	<onunload>ClearProperty(aeon.guide.osd,home)</onunload>
	<!-- over the playing channel: start on the playing channel (now, and again once the grid has loaded) -->
	<onload condition="$EXP[FG_GuideOSD]">PVR.EpgGridControl(PlayingChannel)</onload>
	<onload condition="$EXP[FG_GuideOSD]">AlarmClock(fgguideplaying,PVR.EpgGridControl(PlayingChannel),00:01,silent)</onload>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>AG_Background</include>
		<include content="Misc_PVRFrame">
			<param name="title" value="$LOCALIZE[19069]"/>
			<param name="group_label" value="$INFO[Control.GetLabel(30)]"/>
			<param name="show_group" value="true"/>
			<param name="fg_subnav" value="false"/>
		</include>

		<!-- Fused Glass (0.46.0, mockups LiveTVGuide / LiveTVGuideOverlay): _src/fg_livetv.py -->
		<include condition="Skin.HasSetting(aeon.fglass)">FG_PVRGuideBack</include>
		<!-- ====== grid (focus group 9100: grid, else the empty-state button) -->
		<!-- 0.54.7: Back in the grid opens the EPG tools. Opened straight from <onback>, the modal panel ran inside the
		     Back action, and when it closed Kodi finished that Back and left the guide. This 1 px button takes the focus,
		     hands it back to the grid and opens the panel from an alarm, after the Back action has ended. -->
		<control type="button" id="6058"><left>0</left><top>0</top><width>1</width><height>1</height><label></label><texturefocus /><texturenofocus /><onfocus>SetFocus(9100)</onfocus><onfocus>AlarmClock(aeonepgtools,ActivateWindow(pvrguidecontrols),00:00,silent)</onfocus><visible>!$EXP[FG_GuideOSD]</visible></control>
		<control type="group" id="9100">
			<defaultcontrol always="true">50</defaultcontrol>
			<control type="epggrid" id="50">
				<onback condition="!$EXP[FG_GuideOSD]">6058</onback>
				<onback condition="$EXP[FG_GuideOSD]">6057</onback>
				<include>FG_EpgGrid</include>
				<onup condition="!Skin.HasSetting(aeon.fglass)">9001</onup>
				<onup condition="Skin.HasSetting(aeon.fglass)">6056</onup>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="19069">list</viewtype>
				<include>Misc_EPGLayouts</include>
			</control>
			<include content="Misc_EmptyStateButton">
				<param name="top" value="misc_pvr_top"/>
				<param name="label" value="$LOCALIZE[31640]"/>
			</include>
		</control>
		<!-- 0.56.13 the channel number being typed: in the corner over the channel column (Aeon, Glass) -->
		<control type="group"><left>page_margin</left><top>misc_pvr_top</top><visible>!Skin.HasSetting(aeon.fglass) + !String.IsEmpty(PVR.ChannelNumberInput)</visible><animation type="Visible"><effect type="fade" start="0" end="100" time="120"/></animation>
			<control type="image"><width>300</width><height>45</height><texture border="22,0,22,0" colordiffuse="$VAR[Aeon_Accent]">$VAR[Aeon_MenuTexPill]</texture></control>
			<control type="label"><left>18</left><width>140</width><height>45</height><aligny>center</aligny><font>small_20_semibold</font><textcolor>$VAR[Aeon_AccentText]</textcolor><label>[UPPERCASE]$LOCALIZE[19029][/UPPERCASE]</label></control>
			<control type="label"><left>140</left><width>142</width><height>45</height><align>right</align><aligny>center</aligny><font>st_ui_24_bold</font><textcolor>$VAR[Aeon_AccentText]</textcolor><label>$INFO[PVR.ChannelNumberInput]</label></control>
		</control>
		<control type="group">
			<animation effect="slide" end="0,-290" time="0" condition="$EXP[FG_GuideOSD]">Conditional</animation>
		<include content="AG_Scrollbar" condition="Skin.HasSetting(aeon.fglass)">
			<param name="id" value="60"/>
			<param name="left" value="1804"/>
			<param name="top" value="464"/>
			<param name="height" value="560"/>
			<param name="onleft" value="50"/>
			<param name="onright" value="50"/>
			<param name="onback" value="50"/>
		</include>
		</control>
		<include content="AG_Scrollbar" condition="!Skin.HasSetting(aeon.fglass)">
			<param name="id" value="60"/>
			<param name="left" value="1828"/>
			<param name="top" value="295"/>
			<param name="height" value="594"/>
			<param name="onleft" value="50"/>
			<param name="onright" value="50"/>
			<param name="onback" value="50"/>
		</include>

		<!-- ====== selected programme -->
		<control type="group">
			<left>page_margin</left>
			<top>910</top>
			<width>page_width</width>
			<visible>Control.IsVisible(50) + Integer.IsGreater(Container.NumItems,0) + !$EXP[Aeon_FGlass]</visible>
			<control type="group">
				<visible>!$EXP[Aeon_FGlass]</visible>
				<include content="AG_Rule">
					<param name="left" value="0"/>
					<param name="top" value="0"/>
				</include>
			</control>
			<control type="grouplist">
				<left>0</left>
				<top>16</top>
				<width>page_width</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>24</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="1000">auto</width>
					<height>40</height>
					<font>un_ui_22_bold</font>
					<label>$VAR[Misc_PVRTitle]$INFO[ListItem.EpisodeName,  ·  ,]</label>
				</control>
				<control type="label">
					<top>4</top>
					<width max="700">auto</width>
					<height>34</height>
					<font>cap_20</font>
					<textcolor>$VAR[AG_Accent]</textcolor>
					<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, - ,]$INFO[ListItem.Genre,  ·  ,]</label>
				</control>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>62</top>
				<width>page_width</width>
				<height>66</height>
				<font>body_24</font>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>  <!-- standard Kodi plot scroll: wait 6s, roll, pause 10s, repeat -->
			</control>
		</control>
		<include condition="$EXP[FGS]">FGS_GuideDays</include>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!--
	TV / Radio timers and timer rules (Kodi uses this file for TVTimers, TVTimerRules, RadioTimers,
	RadioTimerRules). SPEC 5: Minimal. Builder F, M4.
	Kodi id contract (Estuary Omega MyPVRTimers.xml + GUIWindowPVRBase.h): view container 50,
	menucontrol 9000, sort 3 / 4, header labels 29 / 30, hide-disabled radio 8.
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<!-- 0.39.3: opened with Left / Right on the area tabs: the focus stays on the tabs -->
	<onload condition="!String.IsEmpty(Window(Home).Property(aeon.pvrnav)) + [Window.IsActive(TVTimerRules) | Window.IsActive(RadioTimerRules)]">SetFocus(104)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(aeon.pvrnav)) + ![Window.IsActive(TVTimerRules) | Window.IsActive(RadioTimerRules)]">SetFocus(103)</onload>
	<onload>ClearProperty(aeon.pvrnav,home)</onload>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>AG_Background</include>
		<include content="Misc_PVRFrame">
			<param name="title" value="$VAR[Misc_PVRTimersTitle]"/>
			<param name="options" value="Misc_PVROptions_Timers"/>
		</include>
		<include content="Misc_PVRList">
			<param name="label2" value="$INFO[ListItem.Date]"/>
			<param name="empty_label" value="$ADDON[skin.aeon.fuse 32359]"/>
		</include>
		<control type="label">
			<left>misc_pvr_panel_x</left>
			<top>1010</top>
			<width>misc_pvr_panel_w</width>
			<height>28</height>
			<font>cap_20</font>
			<textcolor>$VAR[AG_Ink3]</textcolor>
			<label>$INFO[PVR.NextTimer]</label>
		</control>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!--
	Picture slideshow overlay, Aeon style. Kodi draws the pictures; the skin adds, while paused, a narrow left rail
	of two-line facts (FILE / SIZE / TAKEN / SLIDE) like the Aeon picture viewer, and a round play mark when the
	current slide is a video that isn't playing. No Kodi control ids (Estuary Omega SlideShow.xml has none).
	Info opens DialogPictureInfo; Back / Stop exit.
-->
<window>
	<controls>
		<!-- video slide waiting to be played -->
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>136</width>
			<height>136</height>
			<visible>SlideShow.IsVideo</visible>
			<visible>![Player.Playing + Player.HasVideo] | SlideShow.IsPaused</visible>
			<control type="image">
				<width>136</width>
				<height>136</height>
				<texture colordiffuse="b0000000">aeon/circle_64.png</texture>
			</control>
			<control type="image">
				<left>44</left>
				<top>44</top>
				<width>48</width>
				<height>48</height>
				<texture colordiffuse="ffffffff">aeon/icons/play.png</texture>
			</control>
		</control>
		<!-- paused: the left rail -->
		<control type="group">
			<left>0</left>
			<top>0</top>
			<width>440</width>
			<height>1080</height>
			<visible>SlideShow.IsPaused</visible>
			<animation type="Visible" tween="cubic" easing="out" condition="!Skin.HasSetting(aeon.reducemotion)">
				<effect type="slide" start="-440" end="0" time="300"/>
				<effect type="fade" start="0" end="100" time="300"/>
			</animation>
			<animation type="Hidden" tween="cubic" easing="in" condition="!Skin.HasSetting(aeon.reducemotion)">
				<effect type="slide" start="0" end="-440" time="200"/>
				<effect type="fade" start="100" end="0" time="200"/>
			</animation>
			<control type="image">
				<width>440</width>
				<height>1080</height>
				<texture colordiffuse="d8000000">common/white.png</texture>
			</control>
			<control type="image">
				<left>439</left>
				<width>1</width>
				<height>1080</height>
				<texture colordiffuse="30ffffff">common/white.png</texture>
			</control>
			<control type="label">
				<left>45</left>
				<top>48</top>
				<width>360</width>
				<height>40</height>
				<font>pl_ui_26</font>
				<textcolor>ccffffff</textcolor>
				<label>$ADDON[skin.aeon.fuse 32365] [B]$INFO[Slideshow.SlideIndex][/B]</label>
			</control>
			<include content="Aeon_SlideFact">
				<param name="top">250</param>
				<param name="top_key">244</param>
				<param name="top_val">272</param>
				<param name="icon">aeon/icons/film.png</param>
				<param name="key">$ADDON[skin.aeon.fuse 32378]</param>
				<param name="value">$INFO[SlideShow.Filename]</param>
			</include>
			<include content="Aeon_SlideFact">
				<param name="top">390</param>
				<param name="top_key">384</param>
				<param name="top_val">412</param>
				<param name="icon">aeon/icons/settings.png</param>
				<param name="key">$ADDON[skin.aeon.fuse 32379]</param>
				<param name="value">$INFO[SlideShow.Resolution]</param>
			</include>
			<include content="Aeon_SlideFact">
				<param name="top">530</param>
				<param name="top_key">524</param>
				<param name="top_val">552</param>
				<param name="icon">aeon/icons/clock.png</param>
				<param name="key">$ADDON[skin.aeon.fuse 32380]</param>
				<param name="value">$INFO[SlideShow.EXIFTime]</param>
			</include>
			<include content="Aeon_SlideFact">
				<param name="top">670</param>
				<param name="top_key">664</param>
				<param name="top_val">692</param>
				<param name="icon">aeon/icons/pause.png</param>
				<param name="key">$ADDON[skin.aeon.fuse 32381]</param>
				<param name="value">$LOCALIZE[31356]</param>
			</include>
			<control type="label">
				<left>45</left>
				<top>1000</top>
				<width>360</width>
				<height>34</height>
				<font>pl_ui_26</font>
				<textcolor>ccffffff</textcolor>
				<label>$INFO[System.Time(HH:mm)]</label>
			</control>
		</control>
	</controls>
</window>

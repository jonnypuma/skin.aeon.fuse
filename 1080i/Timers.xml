		<onstart>AlarmClock(aeonsplashfin,SetProperty(aeon.splash.fin,1,home),00:01,silent)</onstart>
	</timer>
	<timer>
		<name>aeonsplashfin</name>
		<description>0.56.53 the splash ends one second after aeonsplashend saw everything in (or the 40 s cap)</description>
		<start>!String.IsEmpty(Window(Home).Property(aeon.splash.fin))</start>
		<stop>true</stop>
		<onstart condition="Window.IsActive(home) + Control.HasFocus(9999)">SetFocus(9000)</onstart>
		<onstart condition="Control.HasFocus(9990)">SetFocus(10)</onstart>
		<onstart>ClearProperty(aeon.splash,home)</onstart>
		<onstart>ClearProperty(aeon.splash.to,home)</onstart>
		<onstart>ClearProperty(aeon.splash.fin,home)</onstart>
		<onstart>ClearProperty(aeon.splash.ending,home)</onstart>
	</timer>
</timers>

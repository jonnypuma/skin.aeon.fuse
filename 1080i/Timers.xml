		<stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonstripart),1)</stop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,movies)">SetProperty(aeon.stripfirst,$INFO[Container(9301).ListItemAbsolute(0).DBType],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,tv)">SetProperty(aeon.stripfirst,$INFO[Container(9302).ListItemAbsolute(0).DBType],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,music)">SetProperty(aeon.stripfirst,$INFO[Container(9303).ListItemAbsolute(0).DBType],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,movies) + [String.IsEmpty(Window(Home).Property(aeon.subsel.movies)) | String.IsEqual(Window(Home).Property(aeon.subsel.movies),1)]">SetProperty(aeon.stripart,$INFO[Container(9391).ListItemAbsolute(0).Property(art)],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,movies) + String.IsEqual(Window(Home).Property(aeon.subsel.movies),2)">SetProperty(aeon.stripart,$INFO[Container(9391).ListItemAbsolute(1).Property(art)],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,movies) + String.IsEqual(Window(Home).Property(aeon.subsel.movies),3)">SetProperty(aeon.stripart,$INFO[Container(9391).ListItemAbsolute(2).Property(art)],home)</onstop>
		<onstop condition="Window.IsActive(home) + String.IsEqual(Container(9000).ListItem.Label2,movies) + String.IsEqual(Window(Home).Property(aeon.subsel.movies),4)">SetProperty(aeon.stripart,$INFO[Container(9391).ListItemAbsolute(3).Property(art)],home)</onstop>

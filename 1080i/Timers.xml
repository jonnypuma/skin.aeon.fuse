<?xml version="1.0" encoding="UTF-8"?>
<!-- Aeon Fuse: the spotlight window (1157) advances to the next item after the hold time (Skin settings > Home sub-menus).
     Any key press resets it. Hold time and item count of the focused page are in Window(Home) aeon.spot.holdnow / countnow. -->
<timers>
	<timer>
		<name>aeonspot</name>
		<description>Spotlight autoscroll</description>
		<start>Window.IsVisible(1157)</start>
		<reset>!System.IdleTime(1)</reset>
		<stop>!Window.IsVisible(1157) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonspot),Window(Home).Property(aeon.spot.holdnow))</stop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9401) + [Integer.IsEqual(Container(9401).CurrentItem,Container(9401).NumItems) | Integer.IsGreaterOrEqual(Container(9401).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9401,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9401) + ![Integer.IsEqual(Container(9401).CurrentItem,Container(9401).NumItems) | Integer.IsGreaterOrEqual(Container(9401).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9401,1)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9402) + [Integer.IsEqual(Container(9402).CurrentItem,Container(9402).NumItems) | Integer.IsGreaterOrEqual(Container(9402).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9402,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9402) + ![Integer.IsEqual(Container(9402).CurrentItem,Container(9402).NumItems) | Integer.IsGreaterOrEqual(Container(9402).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9402,1)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9403) + [Integer.IsEqual(Container(9403).CurrentItem,Container(9403).NumItems) | Integer.IsGreaterOrEqual(Container(9403).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9403,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9403) + ![Integer.IsEqual(Container(9403).CurrentItem,Container(9403).NumItems) | Integer.IsGreaterOrEqual(Container(9403).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9403,1)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9404) + [Integer.IsEqual(Container(9404).CurrentItem,Container(9404).NumItems) | Integer.IsGreaterOrEqual(Container(9404).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9404,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9404) + ![Integer.IsEqual(Container(9404).CurrentItem,Container(9404).NumItems) | Integer.IsGreaterOrEqual(Container(9404).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9404,1)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9405) + [Integer.IsEqual(Container(9405).CurrentItem,Container(9405).NumItems) | Integer.IsGreaterOrEqual(Container(9405).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9405,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9405) + ![Integer.IsEqual(Container(9405).CurrentItem,Container(9405).NumItems) | Integer.IsGreaterOrEqual(Container(9405).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9405,1)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9406) + [Integer.IsEqual(Container(9406).CurrentItem,Container(9406).NumItems) | Integer.IsGreaterOrEqual(Container(9406).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">SetFocus(9406,0,absolute)</onstop>
		<onstop condition="Window.IsVisible(1157) + Control.HasFocus(9406) + ![Integer.IsEqual(Container(9406).CurrentItem,Container(9406).NumItems) | Integer.IsGreaterOrEqual(Container(9406).CurrentItem,Window(Home).Property(aeon.spot.countnow))]">Control.Move(9406,1)</onstop>
	</timer>
	<timer>
		<name>aeonfanx</name>
		<description>Extra fanart cycling</description>
		<start>Skin.HasSetting(aeon.extrafanart)</start>
		<stop>!Skin.HasSetting(aeon.extrafanart) | [[String.IsEmpty(Skin.String(aeon.extrafanart.interval)) | String.IsEqual(Skin.String(aeon.extrafanart.interval),10)] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonfanx),10)] | [String.IsEqual(Skin.String(aeon.extrafanart.interval),15) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonfanx),15)] | [String.IsEqual(Skin.String(aeon.extrafanart.interval),30) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonfanx),30)] | [String.IsEqual(Skin.String(aeon.extrafanart.interval),5) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonfanx),5)]</stop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + [String.IsEmpty(Window(Home).Property(aeon.fanx)) | String.IsEqual(Window(Home).Property(aeon.fanx),0)]">SetProperty(aeon.fanx,1,home)</onstop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + String.IsEqual(Window(Home).Property(aeon.fanx),1)">SetProperty(aeon.fanx,2,home)</onstop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + String.IsEqual(Window(Home).Property(aeon.fanx),2)">SetProperty(aeon.fanx,3,home)</onstop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + String.IsEqual(Window(Home).Property(aeon.fanx),3)">SetProperty(aeon.fanx,4,home)</onstop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + String.IsEqual(Window(Home).Property(aeon.fanx),4)">SetProperty(aeon.fanx,5,home)</onstop>
		<onstop condition="Skin.HasSetting(aeon.extrafanart) + String.IsEqual(Window(Home).Property(aeon.fanx),5)">SetProperty(aeon.fanx,0,home)</onstop>
	</timer>
	<timer>
		<name>aeonpause</name>
		<description>Controls open on pause</description>
		<start>Player.Paused + Player.HasVideo + Skin.HasSetting(aeon.osdpause) + String.IsEmpty(Window(Home).Property(aeon.pauseosd))</start>
		<stop>!Player.Paused | !Skin.HasSetting(aeon.osdpause) | [String.IsEqual(Skin.String(aeon.osdpause.delay),1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonpause),1)] | [String.IsEqual(Skin.String(aeon.osdpause.delay),2) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonpause),2)] | [String.IsEqual(Skin.String(aeon.osdpause.delay),3) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonpause),3)] | [String.IsEqual(Skin.String(aeon.osdpause.delay),5) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonpause),5)] | [String.IsEmpty(Skin.String(aeon.osdpause.delay)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(aeonpause),2)]</stop>
		<onstop condition="Player.Paused + Skin.HasSetting(aeon.osdpause) + Window.IsActive(fullscreenvideo)">SetProperty(aeon.pauseosd,1,home)</onstop>
		<onstop condition="Player.Paused + Skin.HasSetting(aeon.osdpause) + Window.IsActive(fullscreenvideo)">ActivateWindow(videoosd)</onstop>
	</timer>
	<timer>
		<name>aeonpauseclr</name>
		<description>Re-arm controls on pause after resume</description>
		<start>!Player.Paused + !String.IsEmpty(Window(Home).Property(aeon.pauseosd))</start>
		<stop>true</stop>
		<onstop>ClearProperty(aeon.pauseosd,home)</onstop>
	</timer>

msgstr "zdroj"

msgctxt "#32639"
msgid "No pictures yet"
msgstr "Zatím žádné obrázky"

msgctxt "#32640"
msgid "Add a folder of photos as a picture source in the Pictures window. OK opens it."
msgstr "V okně Obrázky přidejte složku s fotkami jako zdroj obrázků. OK ho otevře."

msgctxt "#32641"
msgid "Photos"
msgstr "Fotky"

msgctxt "#32642"
msgid "OK opens the photo · Up for sort, slideshow and view"
msgstr "OK otevře fotku · Nahoru pro řazení, prezentaci a zobrazení"

msgctxt "#32643"

msgstr "Ladataanko %s tallennetut asetukset? Nykyiset ulkoasun asetukset korvataan."

msgctxt "#32735"
msgid "This file does not hold Aeon Fuse settings."
msgstr "Tässä tiedostossa ei ole Aeon Fusen asetuksia."

msgctxt "#32736"
msgid "The file could not be written."
msgstr "Tiedostoa ei voitu kirjoittaa."

msgctxt "#32737"
msgid "Kodi restarts to apply them."
msgstr "Kodi käynnistyy uudelleen ottaakseen ne käyttöön."

msgctxt "#32738"
msgid "The skin reloads; restart Kodi afterwards so every setting is read again."
msgstr "Ulkoasu ladataan uudelleen; käynnistä Kodi sen jälkeen uudelleen, jotta kaikki asetukset luetaan uudelleen."

msgctxt "#32739"
msgid "These settings are already in use."
msgstr "Nämä asetukset ovat jo käytössä."

msgctxt "#32740"
msgid "Soft"
msgstr "Pehmeä"

msgctxt "#32741"
msgid "Home gradient"
msgstr "Kodin liukuväri"

msgctxt "#32742"

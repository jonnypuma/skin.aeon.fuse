msgctxt "#32553"
msgid "Also show what aired on the days of this week before today (episodes in your library)."
msgstr "Mutassa azt is, mi jelent meg a hét mai nap előtti napjain (epizódok a médiatárban)."

msgctxt "#32554"
msgid "Menu names in capitals"
msgstr "Menünevek nagybetűvel"


msgid "The artwork of the spotlight title"
msgstr "Изображение названия в Spotlight"

msgctxt "#32079"
msgid "Fanart of the title in the spotlight, with a soft fade from the left."
msgstr "Фанарт названия в Spotlight с мягким затуханием слева."

msgctxt "#32080"
msgid "A colour taken from the artwork"
msgstr "Цвет из изображения"

msgctxt "#32081"
msgid "A warm or cool tint drawn from the title's artwork."
msgstr "Тёплый или холодный оттенок из изображения названия."

msgctxt "#32082"
msgid "A quiet dark background"
msgstr "Спокойный тёмный фон"

msgctxt "#32083"
msgid "No artwork behind the spotlight text."
msgstr "Без изображения за текстом Spotlight."

msgctxt "#32084"
msgid "One picture dissolves into the next"
msgstr "Одна картинка перетекает в следующую"

msgctxt "#32085"
msgid "A soft cross-fade."
msgstr "Мягкое перекрёстное затухание."

msgctxt "#32086"
